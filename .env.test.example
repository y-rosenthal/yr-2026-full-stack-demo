# ==============================================================================
# SETTINGS FOR THE AUTOMATED TESTS (OPTIONAL)
# ==============================================================================
#
# What is this file?
#   The project has automated tests: small programs that check that the app
#   works (run them with: npm test). The tests read their settings from a file
#   named .env.test.local. This file, .env.test.example, is a template for it,
#   with fake values (XXXX). You do NOT need it to run the app; for that, see
#   .env.example.
#
# What does XXXX mean?
#   A value with XXXX in it is a placeholder: it only shows what your value
#   looks like. It is not a real value. Replace the whole value between the
#   quotes with the value you copy from the website. For example,
#   "sk_test_XXXX" becomes your whole Stripe secret key, "sk_test_51AbC...".
#   (The key you copy already starts with sk_test_, so don't type that part
#   twice.)
#
# How to use it:
#   1. Make a copy of this file in the same folder, named .env.test.local
#      (in the terminal: cp .env.test.example .env.test.local).
#   2. In .env.test.local, replace each placeholder value (everything between
#      the quotes) with your own value. Keep the quotes. Don't put spaces
#      around the =.
#   3. Save it.
#
# Only on your computer:
#   The tests run only on your computer. Nothing in this file goes to Vercel
#   or to Supabase.
#
# WARNING: SECRET KEYS
#   .env.test.local holds secret keys. Anyone who has them can read and change
#   everything in your database and use your Stripe account. Never share them,
#   never paste them into a chat, and never put them in .env.local or in any
#   file whose name doesn't end in .local (Git skips only those files, so the
#   others could end up on GitHub).
# ==============================================================================

# --- Supabase -----------------------------------------------------------------

# The same two values as in your .env.local.
NEXT_PUBLIC_SUPABASE_URL="https://XXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXX"

# Your Supabase project's SECRET key. It starts with sb_secret_
# It skips all of the database's security rules, so the tests can create and
# delete test data.
# Where to find it: Supabase dashboard > Project Settings > API Keys, under
# Secret keys. Click the copy icon next to it (the eye icon shows the key).
SUPABASE_SECRET_KEY="sb_secret_XXXX"

# --- Stripe, in test mode (a "sandbox": no real money) ------------------------

# Your Stripe secret key. It starts with sk_test_
# Where to find it: Stripe dashboard (in your sandbox) > API keys
# (https://dashboard.stripe.com/apikeys).
STRIPE_SECRET_KEY="sk_test_XXXX"

# The ID of the monthly price of your product. It starts with price_
# Where to find it: Stripe dashboard > Product catalog > your product > its price.
STRIPE_PRICE_ID="price_XXXX"

# Your webhook's signing secret. It starts with whsec_
# Where to find it: Stripe dashboard > Webhooks > your webhook's page
# (https://dashboard.stripe.com/webhooks), "Signing secret" > Reveal.
STRIPE_WEBHOOK_SECRET="whsec_XXXX"
